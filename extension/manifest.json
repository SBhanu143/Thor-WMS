{
  "manifest_version": 3,
  "name": "Thor WMS — Warehouse Command Center",
  "version": "1.0.0",
  "description": "Professional warehouse management tools by Thor Creations. Generate QR codes, barcodes, format bin locations, and scan labels — all from Chrome's side panel.",
  "permissions": [
    "sidePanel",
    "storage",
    "activeTab"
  ],
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Thor WMS — Warehouse Command Center",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
